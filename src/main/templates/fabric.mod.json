{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "Unofficial community continuation of FlightAssistant for modern Minecraft versions (26.2+) with bug fixes.",
    "authors": [
        "Henner4746 (Port Maintainer)",
        "Octol1ttle (Original Author)",
        "mctaylors"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/flightassistant-continued",
        "sources": "https://github.com/Henner4746/FlightAssistant",
        "issues": "https://github.com/Henner4746/FlightAssistant/issues"
    },
    "license": "LGPL-3.0-only",
    "icon": "assets/flightassistant/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "value": "ru.octol1ttle.flightassistant.FlightAssistantFabric",
                "adapter": "kotlin"
            }
        ],
        "modmenu": [
            {
                "value": "ru.octol1ttle.flightassistant.config.FAModMenuIntegration",
                "adapter": "kotlin"
            }
        ]
    },
    "depends": {
        "fabricloader": ">=0.16.3",
        "minecraft": "${mc}",
        "java": ">=17",
        "architectury": "*",
        "fabric-language-kotlin": "*",
        "yet_another_config_lib_v3": "*"
    },
    "recommends": {
        "modmenu": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/5kcBCvnbTp"
            }
        }
    }
}
